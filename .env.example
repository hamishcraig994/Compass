# Copy to .env (which git ignores) and fill in. Don't commit real tokens.
# Easier alternative: leave this file alone and use the app's own Settings page instead - it has
# one tab per app below, a Test connection button, and pulls Radarr/Sonarr's quality profiles and
# root folders into dropdowns once that app's reachable. Whatever you set here is just the
# first-boot default; a value saved through Settings always wins.
PLEX_URL=http://192.168.1.102:32400
# Plex Web -> any item -> ... -> Get Info -> View XML -> copy X-Plex-Token=... from the address bar
# Still used (if set) to list what's in your library, even when HISTORY_SOURCE=tautulli below.
PLEX_TOKEN=
# themoviedb.org -> Settings -> API -> "API Read Access Token" (or the shorter v3 API Key)
TMDB_TOKEN=

# Where watch history comes from: "plex" (default) or "tautulli". Tautulli keeps history for
# titles even after you delete them from Plex, which direct Plex access can't see.
HISTORY_SOURCE=plex
# Tautulli -> Settings -> Web Interface -> API -> API Key. URL is Tautulli's own address (often
# the same host as Plex, a different port - commonly :8181).
TAUTULLI_URL=
TAUTULLI_API_KEY=
# Tautulli username to filter history to (leave blank to include everyone on the server).
TAUTULLI_USER=

# Optional: adds an "Add to library" button on movie/TV cards, and excludes anything already
# tracked there from recommendations (not just what's in Plex). Radarr/Sonarr -> Settings ->
# General -> API Key. Quality profile ID and root folder are optional - leave blank to use
# whichever one Radarr/Sonarr lists first (check Settings -> Profiles / Media Management there).
RADARR_URL=http://192.168.1.100:7878
RADARR_API_KEY=
RADARR_QUALITY_PROFILE_ID=
RADARR_ROOT_FOLDER=

SONARR_URL=http://192.168.1.100:8989
SONARR_API_KEY=
SONARR_QUALITY_PROFILE_ID=
SONARR_ROOT_FOLDER=

# Optional: once set, a dedicated "AI" page appears in the sidebar with a Generate button that
# asks an LLM for ideas grounded in your taste profile. Manual only - it never runs as part of the
# automatic Recommended list, so it never costs an API call unless you click Generate. Any
# OpenAI-compatible provider works (OpenAI itself, a self-hosted server, OpenRouter, etc.) - change
# AI_PROVIDER_URL for anything other than OpenAI. Every suggestion is verified against real TMDB
# data before being trusted (see ai.py/recommend.py) and scored the same as everything else - no
# special bonus for coming from the AI.
AI_PROVIDER_URL=https://api.openai.com/v1
AI_TOKEN=
AI_MODEL=gpt-4o-mini
