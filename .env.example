# Copy to .env (which git ignores) and fill in. Don't commit real tokens.
PLEX_URL=http://192.168.1.102:32400
# Plex Web -> any item -> ... -> Get Info -> View XML -> copy X-Plex-Token=... from the address bar
# Still used (if set) to list what's in your library, even when HISTORY_SOURCE=tautulli below.
PLEX_TOKEN=
# themoviedb.org -> Settings -> API -> "API Read Access Token" (or the shorter v3 API Key)
TMDB_TOKEN=

# Where watch history comes from: "plex" (default) or "tautulli". Tautulli keeps history for
# titles even after you delete them from Plex, which direct Plex access can't see.
HISTORY_SOURCE=plex
# Tautulli -> Settings -> Web Interface -> API -> API Key. URL is Tautulli's own address (often
# the same host as Plex, a different port - commonly :8181).
TAUTULLI_URL=
TAUTULLI_API_KEY=
# Tautulli username to filter history to (leave blank to include everyone on the server).
TAUTULLI_USER=
